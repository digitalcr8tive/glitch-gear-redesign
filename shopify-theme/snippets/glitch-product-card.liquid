{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign single_variant = false
  if product.has_only_default_variant and selected_variant.available
    assign single_variant = true
  endif
-%}
<article class="gh-product-card{% unless product.available %} is-sold-out{% endunless %}">
  <a class="gh-product-media" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
    <span class="gh-availability-badge{% unless product.available %} is-sold-out{% endunless %}">{% if product.available %}Available{% else %}Sold out{% endif %}</span>
    {%- if product.featured_image != blank -%}
      {%- capture preserved_url -%}{% render 'glitch-product-image', image: product.featured_image, width: 620 %}{%- endcapture -%}
      <img src="{{ preserved_url | strip }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="620" height="620" loading="lazy">
    {%- endif -%}
  </a>
  <div class="gh-product-body">
    <a href="{{ product.url }}">
      <h3>{{ product.title }}</h3>
      <span>{{ product.price | money }}</span>
    </a>
    {%- if product.available and single_variant -%}
      <product-form>
        {%- form 'product', product, class: 'gh-quick-form', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
          <button class="gh-cart-action" type="submit" name="add" aria-label="Add {{ product.title | escape }} to cart">
            {% render 'glitch-icon', icon: 'cart' %}
          </button>
        {%- endform -%}
      </product-form>
    {%- elsif product.available -%}
      <a class="gh-cart-action" href="{{ product.url }}" aria-label="Choose options for {{ product.title | escape }}">→</a>
    {%- else -%}
      <span class="gh-cart-action gh-sold-out-action" aria-label="{{ product.title | escape }} is sold out">×</span>
    {%- endif -%}
  </div>
</article>
