<section class="gh-hero" aria-labelledby="GlitchHeroTitle-{{ section.id }}"{% if section.settings.background != blank %} style="--gh-hero-bg:url('{{ section.settings.background | image_url: width: 2400 }}')"{% endif %}>
  <div class="gh-hero-model gh-left">
    {%- if section.settings.left_model != blank -%}
      {{ section.settings.left_model | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', sizes: '(min-width: 768px) 30vw, 50vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.left_model_alt }}
    {%- endif -%}
  </div>
  <div class="gh-hero-copy">
    <h1 id="GlitchHeroTitle-{{ section.id }}"><span>{{ section.settings.heading_one }}</span><strong>{{ section.settings.heading_two }}</strong></h1>
    <p>{{ section.settings.supporting_one }}<br>{{ section.settings.supporting_two }}</p>
    <div>
      {%- if section.settings.primary_label != blank -%}<a class="gh-button gh-primary" href="{{ section.settings.primary_url }}">{{ section.settings.primary_label }} <span aria-hidden="true">→</span></a>{%- endif -%}
      {%- if section.settings.secondary_label != blank -%}<a class="gh-button gh-secondary" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label }}</a>{%- endif -%}
    </div>
  </div>
  <div class="gh-hero-model gh-right">
    {%- if section.settings.right_model != blank -%}
      {{ section.settings.right_model | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', sizes: '(min-width: 768px) 30vw, 50vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.right_model_alt }}
    {%- endif -%}
  </div>
  {%- if section.settings.show_hud -%}<div class="gh-hud" aria-hidden="true"><span>XP +250</span><span>LVL 20</span><i></i></div>{%- endif -%}
</section>

{% schema %}
{
  "name": "Glitch three-column hero",
  "tag": "section",
  "class": "gh-hero-section",
  "settings": [
    { "type": "image_picker", "id": "left_model", "label": "Left model" },
    { "type": "text", "id": "left_model_alt", "label": "Left model alt text", "default": "Woman wearing Glitch gaming apparel" },
    { "type": "image_picker", "id": "right_model", "label": "Right model" },
    { "type": "text", "id": "right_model_alt", "label": "Right model alt text", "default": "Man wearing Glitch gaming apparel" },
    { "type": "image_picker", "id": "background", "label": "Optional hero background" },
    { "type": "text", "id": "heading_one", "label": "Heading line one", "default": "WEAR" },
    { "type": "text", "id": "heading_two", "label": "Heading line two", "default": "THE GAME." },
    { "type": "text", "id": "supporting_one", "label": "Supporting line one", "default": "Game-inspired apparel for players." },
    { "type": "text", "id": "supporting_two", "label": "Supporting line two", "default": "Designed to stand out. Made to last." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "SHOP ALL GEAR" },
    { "type": "url", "id": "primary_url", "label": "Primary button URL" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "EXPLORE COLLECTIONS" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button URL" },
    { "type": "checkbox", "id": "show_hud", "label": "Show decorative HUD", "default": true }
  ],
  "presets": [{ "name": "Glitch three-column hero" }]
}
{% endschema %}
