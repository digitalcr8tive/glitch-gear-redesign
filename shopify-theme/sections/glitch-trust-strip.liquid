<section class="gh-trust" aria-label="Store benefits">
  {%- for block in section.blocks -%}
    <div class="gh-trust-item" {{ block.shopify_attributes }}>
      <span>{% render 'glitch-icon', icon: block.settings.icon %}</span>
      <div><strong>{{ block.settings.heading }}</strong><small>{{ block.settings.supporting }}</small></div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Glitch trust strip",
  "tag": "section",
  "class": "gh-trust-section",
  "max_blocks": 4,
  "blocks": [{ "type": "trust_item", "name": "Trust item", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [{"value":"truck","label":"Truck"},{"value":"return","label":"Return"},{"value":"controller","label":"Controller"},{"value":"shield","label":"Shield"}] },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "supporting", "label": "Supporting text" }
  ] }],
  "presets": [{ "name": "Glitch trust strip", "blocks": [
    {"type":"trust_item","settings":{"icon":"truck","heading":"FREE U.S. SHIPPING","supporting":"On orders $75+"}},
    {"type":"trust_item","settings":{"icon":"return","heading":"EASY RETURNS","supporting":"30-day hassle free"}},
    {"type":"trust_item","settings":{"icon":"controller","heading":"GAMER APPROVED","supporting":"Designed by gamers"}},
    {"type":"trust_item","settings":{"icon":"shield","heading":"SECURE CHECKOUT","supporting":"Shop with confidence"}}
  ] }]
}
{% endschema %}
