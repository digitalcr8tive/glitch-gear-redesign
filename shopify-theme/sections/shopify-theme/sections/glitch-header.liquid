<header class="gh-header" data-glitch-header>
  <details class="gh-mobile-menu">
    <summary aria-label="Open navigation">☰</summary>
    <nav aria-label="Mobile navigation">
      {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      <form class="gh-mobile-search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="GlitchMobileSearch-{{ section.id }}">Search gear</label>
        <input id="GlitchMobileSearch-{{ section.id }}" type="search" name="q" placeholder="Search gear..." autocomplete="off">
        <button type="submit">Search gear</button>
      </form>
    </nav>
  </details>
  <a class="gh-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 380 | image_tag: widths: '190,280,380', loading: 'eager', alt: shop.name }}
    {%- else -%}
      <span class="gh-logo-fallback">GLITCH<small>GAMING APPAREL</small></span>
    {%- endif -%}
  </a>
  <nav class="gh-nav" aria-label="Primary navigation">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}{% if link.links != blank %}<span aria-hidden="true">⌄</span>{% endif %}</a>
    {%- endfor -%}
  </nav>
  <div class="gh-tools">
    <form class="gh-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="GlitchSearch-{{ section.id }}">Search gear</label>
      <input id="GlitchSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search gear..." role="combobox" aria-expanded="false" autocomplete="off">
      <button type="submit" aria-label="Search">{% render 'glitch-icon', icon: 'search' %}</button>
    </form>
    {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}" aria-label="Customer account">{% render 'glitch-icon', icon: 'account' %}</a>{%- endif -%}
    {%- if section.settings.show_wishlist and section.settings.wishlist_url != blank -%}<a href="{{ section.settings.wishlist_url }}" aria-label="Wishlist">{% render 'glitch-icon', icon: 'heart' %}</a>{%- endif -%}
    <a class="gh-cart-link" href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items">{% render 'glitch-icon', icon: 'cart' %}<span data-cart-count>{{ cart.item_count }}</span></a>
  </div>
</header>
<script src="{{ 'glitch-homepage.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Glitch header",
  "tag": "section",
  "class": "gh-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Official horizontal logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist", "default": false },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist URL" }
  ],
  "presets": [{ "name": "Glitch header" }]
}
{% endschema %}
