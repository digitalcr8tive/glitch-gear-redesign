<section class="gh-page gh-info-page"><header class="gh-page-heading"><span>GLITCH / NEWS</span><h1>{{ blog.title }}</h1></header><div class="gh-entry-list">{% for article in blog.articles %}<article><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 36 }}</p><a href="{{ article.url }}">Read article →</a></article>{% else %}<p>No articles are published.</p>{% endfor %}</div></section>
