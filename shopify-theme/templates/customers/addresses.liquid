<section class="gh-page gh-account-page"><header class="gh-page-heading"><span>PLAYER / ADDRESSES</span><h1>Saved addresses</h1></header><div class="gh-account-grid"><div>{% for address in customer.addresses %}<article class="gh-address">{{ address | format_address }}{% form 'customer_address', address %}<button type="submit" name="_method" value="delete">Delete address</button>{% endform %}</article>{% endfor %}</div><aside><h2>Add address</h2>{% form 'customer_address', customer.new_address, class: 'gh-account-form' %}{{ form.errors | default_errors }}<label for="AddressFirstName">First name</label><input id="AddressFirstName" type="text" name="address[first_name]" autocomplete="given-name"><label for="AddressLastName">Last name</label><input id="AddressLastName" type="text" name="address[last_name]" autocomplete="family-name"><label for="AddressCompany">Company</label><input id="AddressCompany" type="text" name="address[company]"><label for="Address1">Address</label><input id="Address1" type="text" name="address[address1]" autocomplete="address-line1" required><label for="Address2">Apartment, suite, etc.</label><input id="Address2" type="text" name="address[address2]" autocomplete="address-line2"><label for="AddressCity">City</label><input id="AddressCity" type="text" name="address[city]" autocomplete="address-level2" required><label for="AddressCountry">Country</label><select id="AddressCountry" name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select><label for="AddressZip">Postal code</label><input id="AddressZip" type="text" name="address[zip]" autocomplete="postal-code"><label for="AddressPhone">Phone</label><input id="AddressPhone" type="tel" name="address[phone]" autocomplete="tel"><button class="gh-button gh-primary" type="submit">Add address</button>{% endform %}</aside></div></section>
