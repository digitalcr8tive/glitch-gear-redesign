<section class="gh-page gh-account-page"><header class="gh-page-heading"><span>PLAYER / ACCOUNT</span><h1>Create account</h1></header>{% form 'create_customer', class: 'gh-account-form' %}{{ form.errors | default_errors }}<label for="RegisterFirstName">First name</label><input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name"><label for="RegisterLastName">Last name</label><input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name"><label for="RegisterEmail">Email</label><input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required><label for="RegisterPassword">Password</label><input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required><button class="gh-button gh-primary" type="submit">Create account</button>{% endform %}</section>
