<section class="gh-page gh-account-page"><header class="gh-page-heading"><span>PLAYER / ACCOUNT</span><h1>Reset password</h1></header>{% form 'reset_customer_password', class: 'gh-account-form' %}{{ form.errors | default_errors }}<label for="ResetPassword">New password</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required><label for="ResetPasswordConfirm">Confirm password</label><input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required><button class="gh-button gh-primary" type="submit">Reset password</button>{% endform %}</section>
