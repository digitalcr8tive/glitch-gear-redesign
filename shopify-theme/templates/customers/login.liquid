<section class="gh-page gh-account-page"><header class="gh-page-heading"><span>PLAYER / ACCOUNT</span><h1>Sign in</h1></header>{% form 'customer_login', class: 'gh-account-form' %}{{ form.errors | default_errors }}<label for="CustomerEmail">Email</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required><label for="CustomerPassword">Password</label><input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required><button class="gh-button gh-primary" type="submit">Sign in</button><a href="{{ routes.account_register_url }}">Create account</a>{% endform %}<details class="gh-recover"><summary>Forgot password?</summary>{% form 'recover_customer_password', class: 'gh-account-form' %}{{ form.errors | default_errors }}<label for="RecoverEmail">Email</label><input id="RecoverEmail" type="email" name="email" autocomplete="email" required><button class="gh-button gh-secondary" type="submit">Send reset link</button>{% endform %}</details></section>
