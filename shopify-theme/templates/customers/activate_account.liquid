<section class="gh-page gh-account-page"><header class="gh-page-heading"><span>PLAYER / ACCOUNT</span><h1>Activate account</h1></header>{% form 'activate_customer_password', class: 'gh-account-form' %}{{ form.errors | default_errors }}<label for="ActivatePassword">Password</label><input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required><label for="ActivatePasswordConfirm">Confirm password</label><input id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required><button class="gh-button gh-primary" type="submit">Activate account</button><button class="gh-button gh-secondary" type="submit" name="decline">Decline invitation</button>{% endform %}</section>
