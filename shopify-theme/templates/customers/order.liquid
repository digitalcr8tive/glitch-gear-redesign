<section class="gh-page gh-account-page"><header class="gh-page-heading"><span>PLAYER / ORDER</span><h1>{{ order.name }}</h1><p>{{ order.created_at | date: format: 'date_at_time' }}</p></header><div class="gh-order-list">{% for line_item in order.line_items %}<article><h2>{{ line_item.title }}</h2><p>{{ line_item.quantity }} × {{ line_item.final_price | money }}</p><strong>{{ line_item.final_line_price | money }}</strong></article>{% endfor %}</div><p class="gh-order-total">Total: {{ order.total_net_amount | money_with_currency }}</p></section>
