<section class="gh-page gh-account-page"><header class="gh-page-heading"><span>PLAYER / ACCOUNT</span><h1>{{ customer.name }}</h1><a href="{{ routes.account_logout_url }}">Sign out</a></header><div class="gh-account-grid"><div><h2>Orders</h2>{% paginate customer.orders by 20 %}<div class="gh-order-list">{% for order in customer.orders %}<a href="{{ order.customer_url }}"><strong>{{ order.name }}</strong><span>{{ order.created_at | date: format: 'date' }}</span><span>{{ order.financial_status_label }}</span><span>{{ order.total_net_amount | money_with_currency }}</span></a>{% else %}<p>No orders yet.</p>{% endfor %}</div>{% render 'glitch-pagination', paginate: paginate %}{% endpaginate %}</div><aside><h2>Account details</h2>{{ customer.default_address | format_address }}<a href="{{ routes.account_addresses_url }}">Manage addresses →</a></aside></div></section>
