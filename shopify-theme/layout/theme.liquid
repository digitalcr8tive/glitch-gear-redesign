<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#020304">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Russo+One&display=swap" rel="stylesheet">
    <title>{{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ 'glitch-homepage.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="gh-template-{{ template.name | handle }}">
    <a class="gh-skip-link" href="#MainContent">Skip to content</a>
    {% section 'glitch-announcement-bar' %}
    {% section 'glitch-header' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'glitch-footer' %}
    <script>document.documentElement.classList.remove('no-js');window.Shopify=window.Shopify||{};Shopify.routes=Shopify.routes||{root:{{ routes.root_url | json }}};</script>
    <script src="{{ 'glitch-homepage.js' | asset_url }}" defer></script>
  </body>
</html>
